# Deployment pins for this server -- see HARDENING.md.
#
# Sourced by serve-mxfp4.sh, setup-mxfp4.sh and docker-quickstart.sh. Empty means "not pinned
# yet". Fill it on the server with ./pin-deployment.sh (repo commit + image digest); setup-mxfp4.sh
# records the Hugging Face revisions it downloaded. Commit this file once filled, so the server
# configuration and the code it runs are recorded together. Never edit values by hand into
# anything but a full 40-hex commit or a repo@sha256:<64-hex> image reference.

# git rev-parse HEAD of the reviewed repository commit this host serves
PIN_REPO_COMMIT=6178c85cde76a0653f8635e9a496f0e382369663
# container image by immutable digest, e.g. stilldeadcode/vllm-radiance@sha256:<digest>
PIN_IMAGE=stilldeadcode/vllm-radiance@sha256:45694209177a55a1ab3ba6702fe6e978b1b66a6e66ae3fc066f8d579f7bc4c25
# Hugging Face commit of amd/Qwen3.8-27B-Quark-AWQ-MXFP4 (SRC_REPO)
PIN_SRC_REVISION=5233554c5fa56afda40150556b95573c2d7d29c0
# Hugging Face commit of tcclaviger/Qwen3.8-27B-DFlash2-FP8 (DRAFT_REPO)
PIN_DRAFT_REVISION=ee0cb26a8279b7910cc28d82a8a3e15e4728d56f
